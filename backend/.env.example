APP_ENV=development
SECRET_KEY=dev-change-me-please
FLASK_APP=wsgi:app

# ── Base de datos ──────────────────────────────────────────────────────────
# Modo normal: PostgreSQL. El puerto coincide con .env.docker (5433).
# Si la contraseña tiene caracteres especiales, percent-encodeala en la URL.
DATABASE_URL=postgresql+psycopg://alertafiscal:local-dev-only-change-me@127.0.0.1:5433/alertafiscal
DB_MODE=postgresql

# Pruebas de integración contra una base SEPARADA (su esquema se recrea).
# TEST_DATABASE_URL=postgresql+psycopg://alertafiscal:local-dev-only-change-me@127.0.0.1:5433/alertafiscal_test

# Demo aislada sin PostgreSQL (explícita, nunca en producción):
# DB_MODE=sqlite
# Con DB_MODE=sqlite y sin DATABASE_URL usa backend/instance/dev.db.
# Si tampoco defines DB_MODE=sqlite, el backend falla: no hay fallback silencioso.

# Pool de conexiones. Con 1 worker Gunicorn el máximo es pool_size + max_overflow.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=15
DB_CONNECT_TIMEOUT=5
DB_POOL_RECYCLE=1800

# TLS solo para la nube. El PostgreSQL local en Docker no lo requiere.
# DB_SSLMODE=require
# DB_SSLROOTCERT=C:\ruta\a\supabase-ca.crt

# Esquema dedicado opcional. Debe existir antes de ejecutar migraciones.
# DB_SCHEMA=alertafiscal

# Origen permitido para CORS y cookies (sin barra final).
FRONTEND_ORIGIN=http://localhost:5173
# Opcional: orígenes adicionales separados por coma.
CORS_ORIGINS=

# Cookies: en local sobre HTTP se fuerzan a False/Lax.
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# Duración de sesión.
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15

# La semilla demo exige confirmación explícita (--yes o SEED_CONFIRM=1).
# SEED_CONFIRM=1
