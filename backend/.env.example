APP_ENV=development
SECRET_KEY=dev-change-me-please
FLASK_APP=wsgi:app

# ── Database ───────────────────────────────────────────────────────────────
# Normal mode: PostgreSQL. The port matches .env.docker (5433).
# If the password has special characters, percent-encode it in the URL.
DATABASE_URL=postgresql+psycopg://alertafiscal:local-dev-only-change-me@127.0.0.1:5433/alertafiscal
DB_MODE=postgresql

# Integration tests against a SEPARATE database (its schema is recreated).
# TEST_DATABASE_URL=postgresql+psycopg://alertafiscal:local-dev-only-change-me@127.0.0.1:5433/alertafiscal_test

# Isolated demo without PostgreSQL (explicit, never in production):
# DB_MODE=sqlite
# With DB_MODE=sqlite and no DATABASE_URL it uses backend/instance/dev.db.
# If DB_MODE=sqlite is not set either, the backend fails: there is no silent fallback.

# Connection pool. With 1 Gunicorn worker the maximum is pool_size + max_overflow.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=15
DB_CONNECT_TIMEOUT=5
DB_POOL_RECYCLE=1800

# TLS only for the cloud. Local PostgreSQL in Docker does not need it.
# DB_SSLMODE=require
# DB_SSLROOTCERT=C:\path\to\supabase-ca.crt

# Optional dedicated schema. It must exist before running the migrations.
# DB_SCHEMA=alertafiscal

# Allowed origin for CORS and cookies (no trailing slash).
FRONTEND_ORIGIN=http://localhost:5173
# Optional: extra origins separated by commas.
CORS_ORIGINS=

# Cookies: locally over HTTP they are forced to False/Lax.
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# Session duration.
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15

# The demo seed requires explicit confirmation (--yes or SEED_CONFIRM=1).
# SEED_CONFIRM=1
