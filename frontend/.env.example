# Déjalo vacío para usar el mismo origen (el proxy de Vite redirige /api y /health
# al backend en desarrollo). En producción, apunta al backend de Render, por ejemplo:
# VITE_API_BASE_URL=https://alertafiscal-backend.onrender.com
VITE_API_BASE_URL=

# Destino del proxy de desarrollo. Solo se usa con `npm run dev`.
VITE_API_PROXY_TARGET=http://localhost:5000
