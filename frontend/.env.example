# Leave it empty to use the same origin (the Vite proxy forwards /api and /health
# to the backend in development). In production, point it to the Render backend, for example:
# VITE_API_BASE_URL=https://alertafiscal-backend.onrender.com
VITE_API_BASE_URL=

# Development proxy target. Only used with `npm run dev`.
VITE_API_PROXY_TARGET=http://localhost:5000
